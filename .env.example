# Discord Bot Token
KIKIMIMI_BOT_TOKEN=your_discord_bot_token_here

# Google Cloud Settings
# key/ フォルダ内に認証用JSONファイルを配置し、その相対パスを指定してください
GOOGLE_APPLICATION_CREDENTIALS_PATH=key/google_credentials.json

# Customize (任意)
VERSION="v1.0.1"
UPDATE_INFO="セットアップ手順が改善されました。"
SYSTEM_FOOTER="Kikimimi Reading Bot"
BOT_PRESENCE="github.com/xxxxholica/kikimimi"

# 音楽キャッシュ設定 (任意、サーバー単位)
MUSIC_CACHE_MAX_TRACKS=10
MUSIC_CACHE_MAX_MB=200
MUSIC_VOLUME=0.35
